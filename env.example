# Keep this file as a template. Copy to .env locally and NEVER commit real secrets.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_VISION_MODEL=gemini-3.5-flash-lite

# Authorized camera stream; use a dedicated read-only camera account.
UWI_CAMERA_URL=rtsp://username:password@192.168.1.100:554/stream1
UWI_CAMERA_LOCATION=Main Street Monitoring Point
UWI_CAMERA_LAT=26.8467
UWI_CAMERA_LON=80.9462
UWI_FRAME_INTERVAL_SECONDS=20
UWI_ALERT_COOLDOWN_SECONDS=900
UWI_MIN_CONFIDENCE=70

# Optional HTTPS webhook and HMAC signing secret.
UWI_ALERT_WEBHOOK=https://your-service.example/uwi
UWI_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Optional shared persistent database path. Configure identically for app and worker.
# UWI_DB_PATH=/absolute/path/to/data/uwi.db
