FROM python:3.11-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libglib2.0-0 libgl1 ca-certificates && rm -rf /var/lib/apt/lists/*
COPY requirements-vision.txt requirements.txt ./
RUN pip install --no-cache-dir -r requirements-vision.txt
COPY . .
ENV PYTHONUNBUFFERED=1
CMD ["python", "camera_worker.py"]
